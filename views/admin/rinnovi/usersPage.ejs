<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allievi</title>
    <link rel="stylesheet" href="/styles/admin/users.css">
    <link rel="stylesheet" href="/styles/admin/rinnovi/users.css">
</head>
<body>
    <%- include('../components/header.ejs') %>
    
    <details id="rinnoviMenu">
        <summary><span class="material-symbols-outlined">more_vert</span></summary>
        <ul>
            <li id="filterRinnoviBtn"><span class="material-symbols-outlined">filter_alt</span></li>
            <li id="searchUsersBtn"><span class="material-symbols-outlined">data_loss_prevention</span></li>
        </ul>
    </details>

    <section id="filterRinnovi" style="height: 0;">
        <div class="closeFilterField">
            <span id="closeFilterBtn" class="material-symbols-outlined">close</span>
        </div>
        <div class="fields" style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; max-width: 90dvw; width: 100%;">
            <div class="field">
                <label for="filterName">Nome:</label>
                <input type="text" name="filterName" id="filterName">
            </div>
            <div class="field">
                <label for="filterSurname">Cognome:</label>
                <input type="text" name="filterSurname" id="filterSurname">
            </div>
            <div class="field">
                <label for="filterEmail">Email:</label>
                <input type="email" name="filterEmail" id="filterEmail">
            </div>
            <div class="field">
                <label for="filterPhone">Telefono:</label>
                <input type="tel" name="filterPhone" id="filterPhone">
            </div>
            <div class="field">
                <label for="filterProvenienza">provenienza:</label>
                <select name="filterProvenienza" id="filterProvenienza">
                    <option value="all">Tutte</option>
                    <option value="rinnovopatenti">RinnovoPatenti</option>
                    <option value="interna">Interna</option>
                </select>
            </div>
            <div class="field">
                <p style="color: #f1f1f1;">Stato</p>
                <div class="checkboxField">
                    <label for="active" style="color: #f1f1f1;">Attivi</label>
                    <input type="radio" name="filterArchived" id="active" value="active" checked>
                </div>
                <div class="checkboxField">
                    <label for="archived" style="color: #f1f1f1;">Archiviati</label>
                    <input type="radio" name="filterArchived" id="archived" value="archived">
                </div>
                <div class="checkboxField">
                    <label for="all-status" style="color: #f1f1f1;">Tutti</label>
                    <input type="radio" name="filterArchived" id="all-status" value="all" >
                </div>
            </div>
            <div class="field">
                <p style="color: #f1f1f1;">Fatture</p>
                <div class="checkboxField">
                    <label for="tutti" style="color: #f1f1f1;">Tutti</label>
                    <input type="radio" name="filterFatture" id="tutti" value="all" checked>
                </div>
                <div class="checkboxField">
                    <label for="emesse" style="color: #f1f1f1;">Emesse</label>
                    <input type="radio" name="filterFatture" id="emesse" value="emesse">
                </div>
                <div class="checkboxField">
                    <label for="non-emesse" style="color: #f1f1f1;">Non emesse</label>
                    <input type="radio" name="filterFatture" id="non-emesse" value="non-emesse">
                </div>
            </div>
            <div class="field">
                <h3>Visita Medica</h3><br>
                <div>
                    <label for="filterVisitaFromDate">Da Data:</label>
                    <input type="date" id="filterVisitaFromDate" name="filterVisitaFromDate">
                    <label for="filterVisitaToDate">A Data:</label>
                    <input type="date" id="filterVisitaToDate" name="filterVisitaToDate">
                    <label for="filterVisitaFromHour">Da Ora:</label>
                    <input type="time" id="filterVisitaFromHour" name="filterVisitaFromHour">
                    <label for="filterVisitaToHour">A Ora:</label>
                    <input type="time" id="filterVisitaToHour" name="filterVisitaToHour">
                </div>
            </div>
        </div>
    </section>

    <!-- Menu Filtri Animazione -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterRinnoviBtn = document.getElementById('filterRinnoviBtn');
            const filterRinnovi = document.getElementById('filterRinnovi');
            const closeFilterBtn = document.getElementById('closeFilterBtn');
            const toggleFilterMenu = () => {
                const isClosed = filterRinnovi.style.height == '0px';
                filterRinnovi.style.height = isClosed ? '100%' : '0px';
                setTimeout(() => {
                    filterRinnovi.style.opacity = isClosed ? 1 : 0;
                }, 200);
            }
            filterRinnoviBtn.addEventListener('click', toggleFilterMenu);
            closeFilterBtn.addEventListener('click', toggleFilterMenu);
        });
    </script>

    <!-- Container Ricerca Dati Portale -->
    <div id="blurredBg"></div>
    <section id="searchDataContainer">
        <!-- Mantengo il tuo codice form inalterato per brevità -->
        <form id="searchDataForm" action="/admin/rinnovi/ricerca/portaleAutomobilista" method="POST">
            <div class="field"><span id="closeSearchFormBtn" class="material-symbols-outlined">close</span></div>
            <div class="field"><h3>Cerca Dati</h3></div>
            <div class="field"><label for="nPatente">Numero Patente</label><input type="text" name="nPatente" id="nPatente"></div>
            <div class="field"><label for="cFiscale">Codice Fiscale</label><input type="text" name="cFiscale" id="cFiscale"></div>
            <div class="field"><label for="cognome">Cognome</label><input type="text" name="cognome" id="cognome"></div>
            <div class="field"><button type="submit"><span class="material-symbols-outlined">search</span></button></div>
        </form>
    </section>
    
    <script>
        // Gestione Menu Ricerca (inalterato)
        const searchUsersBtn = document.getElementById('searchUsersBtn');
        const blurredBg = document.getElementById('blurredBg');
        const searchDataContainer = document.getElementById('searchDataContainer');
        const closeSearchFormBtn = document.getElementById('closeSearchFormBtn');
        searchUsersBtn.addEventListener('click', () => {
            blurredBg.style.display = 'block';
            searchDataContainer.style.display = 'flex';
            setTimeout(() => { blurredBg.style.opacity = .4; searchDataContainer.style.opacity = 1; }, 100);
        });
        const closeSearchForm = () => {
            blurredBg.style.opacity = 0; searchDataContainer.style.opacity = 0;
            setTimeout(() => { blurredBg.style.display = 'none'; searchDataContainer.style.display = 'none'; }, 500);
        }
        closeSearchFormBtn.addEventListener('click', closeSearchForm);
        blurredBg.addEventListener('click', closeSearchForm);
    </script>

    <!-- Scarica Giornale Excel / PDF (inalterato) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const downloadGiornaleExcelBtn = document.getElementById('downloadGiornaleExcel');
            const downloadGiornalePdfBtn = document.getElementById('downloadGiornalePdf');
            
            downloadGiornaleExcelBtn.addEventListener("click", (e) => { e.preventDefault(); downloadGiornale('xlsx'); });
            downloadGiornalePdfBtn.addEventListener("click", (e) => { e.preventDefault(); downloadGiornale('pdf'); });
            
            async function downloadGiornale(type) {
                const response = await fetch(`/admin/rinnovi/download/${type}`, {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        fromDate: document.getElementById('filterVisitaFromDate').value,
                        toDate: document.getElementById('filterVisitaToDate').value
                    })
                });
                if(!response.ok) return console.log('Errore download giornale');
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.setAttribute('download', `giornale.${type}`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                window.URL.revokeObjectURL(url); 
            }
        });
    </script>

    <!-- Tabella e Infinite Scroll -->
    <table>
        <form action="/rinnovi/deleteUsers" id="actionUsersForm" method="POST">
            <thead>
                <tr>
                    <th colspan="5"><button id="downloadGiornaleExcel">Scarica Giornale Excel</button></th>
                    <th colspan="5"><button id="downloadGiornalePdf">Scarica Giornale PDF</button></th>
                </tr>
                <tr>
                    <th>
                        <span id="selectUsers" class="material-symbols-outlined" style="cursor: pointer;">checklist</span>
                        <button type="submit" class="elimina theadBtn action" name="action" title="elimina" value="elimina" style="display:none;">
                            <span class="material-symbols-outlined">delete_forever</span>
                        </button>
                        <button type="submit" class="archivia theadBtn action" name="action" title="archivia" value="archive" style="display:none;">
                            <span class="material-symbols-outlined">archive</span>
                        </button>
                    </th>
                    <th>Cognome</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Telefono</th>
                    <th>Visita Medica</th>
                    <th>Registrazione</th>
                    <th>foto</th>
                    <th>firma</th>
                    <th>Fatture</th>
                </tr>
            </thead>
            <!-- Questo corpo ora si riempie tramite JS -->
            <tbody id="usersTableBody"></tbody>
        </form>
    </table>
    
    <!-- Loader (opzionale per styling) -->
    <div id="loader" style="display:none; text-align:center; padding: 20px;">Caricamento...</div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tbody = document.getElementById('usersTableBody');
            const loader = document.getElementById('loader');
            
            // Inputs
            const filterName = document.getElementById('filterName');
            const filterSurname = document.getElementById('filterSurname');
            const filterEmail = document.getElementById('filterEmail');
            const filterPhone = document.getElementById('filterPhone');    
            const filterVisitaFromDate = document.getElementById('filterVisitaFromDate');
            const filterVisitaToDate = document.getElementById('filterVisitaToDate');
            const filterVisitaFromHour = document.getElementById('filterVisitaFromHour');
            const filterVisitaToHour = document.getElementById('filterVisitaToHour');
            const filterProvenienza = document.getElementById('filterProvenienza');
            
            // Checkboxes
            const archiveBtn = document.querySelector('.archivia');
            const archiveBtnSpan = document.querySelector('.archivia span');
            const selectUsersBtn = document.getElementById('selectUsers');

            // Stato Infinite Scroll
            let page = 0;
            const limit = 30;
            let loading = false;
            let finished = false;
            let globalCounter = 0;
            let isSelectionMode = false; // per mantenere lo stato dei bottoni checklist

            const buildQuery = () => {
                const params = new URLSearchParams();
                params.append('page', page);
                
                if (filterName.value.trim()) params.append('nome', filterName.value.trim());
                if (filterSurname.value.trim()) params.append('cognome', filterSurname.value.trim());
                if (filterEmail.value.trim()) params.append('email', filterEmail.value.trim());
                if (filterPhone.value.trim()) params.append('tel', filterPhone.value.trim());
                
                if (filterVisitaFromDate.value) params.append('fromDate', filterVisitaFromDate.value);
                if (filterVisitaToDate.value) params.append('toDate', filterVisitaToDate.value);
                if (filterVisitaFromHour.value) params.append('fromHour', filterVisitaFromHour.value);
                if (filterVisitaToHour.value) params.append('toHour', filterVisitaToHour.value);

                const archivedVal = document.querySelector('input[name="filterArchived"]:checked').value;
                const fattureVal = document.querySelector('input[name="filterFatture"]:checked').value;
                
                params.append('archived', archivedVal);
                params.append('fatture', fattureVal);
                params.append('provenienza', filterProvenienza.value);

                return params.toString();
            };

            const renderRows = (users) => {
                users.forEach((user) => {
                    try { // <--- Aggiunto try/catch: se un utente ha dati corrotti, non blocca gli altri
                        const tr = document.createElement('tr');
                        tr.className = `row ${user.archiviato ? 'archiviato' : ''}`;
                        
                        // FIX 1: Forziamo il display per sovrascrivere eventuali regole CSS che nascondono .archiviato
                        tr.style.display = 'table-row'; 
                        
                        const provBadge = user.provenienza === 'rinnovopatenti' 
                            ? `<span title="proveniente da rinnovopatenti" style="padding: 5px; border-radius: 8px; background: rgb(33, 59, 212); color: #f1f1f1; font-weight: 900;">R</span>` 
                            : '';
                        
                        let dataVisitaStr = 'Mancante';
                        
                        // FIX 2: Controllo sicuro della validità delle date
                        if (user.visita?.data || user.visita?.ora) {
                            let d = '';
                            if (user.visita?.data) {
                                const dateObj = new Date(user.visita.data);
                                // Controlliamo se la data è un formato valido prima di formattarla
                                if (!isNaN(dateObj.getTime())) {
                                    d = dateObj.toISOString().slice(0,10).split('-').reverse().join('/');
                                } else {
                                    d = user.visita.data; // Fallback: stampa la stringa grezza
                                }
                            }
                            const o = user.visita?.ora || '';
                            dataVisitaStr = `${d} ${o}`.trim();
                        }

                        let creationDateStr = 'N/A';
                        if (user.creationDate) {
                            const cDate = new Date(user.creationDate);
                            if (!isNaN(cDate.getTime())) {
                                creationDateStr = cDate.toLocaleDateString();
                            }
                        }
                        
                        let fattureHtml = '';
                        if (!user.fatture || !user.fatture.importo) {
                            fattureHtml = `
                                <a target="_blank" class="pagamenti" href="rinnovi/userPage?id=${encodeURIComponent(user._id)}">
                                    <span class="material-symbols-outlined">euro_symbol</span>
                                </a>`;
                        } else {
                            fattureHtml = `
                                <button class="downloadFattura" title="fattura elettronica" data-number="${user.fatture.numero}" type="button" style="background: none; border: none; outline: none; cursor: pointer;">
                                    <span class="material-symbols-outlined pagamenti">receipt_long</span>
                                </button>
                            `;
                            if (user.fatture.fileCortesia) {
                                fattureHtml += `
                                    <button class="downloadFatturaCortesia" title="fattura di cortesia" data-file="${user.fatture.fileCortesia}" type="button" style="background: none; border: none; outline: none; cursor: pointer;">
                                        <span class="material-symbols-outlined pagamenti">receipt</span>
                                    </button>
                                `;
                            }
                        }

                        globalCounter++;

                        tr.innerHTML = `
                            <td>
                                <div class="cellContent">
                                    <input class="action checkboxUser" type="checkbox" name="user${globalCounter}" value="${user._id}" style="display:${isSelectionMode ? 'inline-flex' : 'none'};">
                                    <div class="numero">${globalCounter}</div>
                                </div>
                            </td>
                            <td style="text-transform: uppercase;">
                                <span>${provBadge} <a target="_blank" href="rinnovi/userPage?id=${encodeURIComponent(user._id)}">${user.cognome}</a></span>
                            </td>
                            <td style="text-transform: uppercase;">${user.nome}</td>
                            <td>${user.contatti?.email || ''}</td>
                            <td>${user.contatti?.tel || ''}</td>
                            <td>${dataVisitaStr}</td>
                            <td>${creationDateStr}</td>
                            <td><input type="checkbox" disabled ${user.hasPhoto ? 'checked' : ''}></td>
                            <td><input type="checkbox" disabled ${user.hasSign ? 'checked' : ''}></td>
                            <td class="buttonCell">${fattureHtml}</td>
                        `;
                        tbody.appendChild(tr);

                    } catch (error) {
                        console.error("Errore saltato per l'utente:", user.nome, user.cognome, error);
                    }
                });
            };

            const loadData = async () => {
                if (loading || finished) return;
                loading = true;
                if(loader) loader.style.display = 'block';

                const response = await fetch(`/admin/api/rinnovi?${buildQuery()}`);
                const result = await response.json();

                if (!result.data || !result.data.length) {
                    finished = true;
                    if(loader) loader.style.display = 'none';
                    loading = false;
                    return;
                }

                renderRows(result.data);
                page++;

                if(loader) loader.style.display = 'none';
                loading = false;
            };

            window.addEventListener('scroll', () => {
                if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) {
                    loadData();
                }
            });

            const resetAndReload = () => {
                page = 0;
                finished = false;
                globalCounter = 0;
                tbody.innerHTML = '';
                
                // Aggiorna l'estetica del pulsante Archivia in base al filtro
                const archived = document.querySelector('input[name="filterArchived"]:checked').value;
                if(archived === 'archived'){
                    archiveBtn.style.display = '';
                    archiveBtn.title="disarchivia";
                    archiveBtn.value = 'unarchive';
                    archiveBtnSpan.style.color = 'green';
                    archiveBtnSpan.innerText = 'unarchive';
                } else if(archived === 'all'){
                    archiveBtn.style.display = 'none';
                } else {
                    archiveBtn.style.display = '';
                    archiveBtn.value = 'archive';
                    archiveBtn.title="archivia";
                    archiveBtnSpan.style.color = 'orange';
                    archiveBtnSpan.innerText = 'archive';
                }

                loadData();
            };

            // Event Listeners dei Filtri (con Debounce per il testo)
            const inputsText = [filterName, filterSurname, filterEmail, filterPhone];
            inputsText.forEach(input => {
                input.addEventListener('input', () => {
                    clearTimeout(window._debounce);
                    window._debounce = setTimeout(resetAndReload, 400);
                });
            });

            const inputsChange = [
                filterVisitaFromDate, filterVisitaToDate, filterVisitaFromHour, filterVisitaToHour,
                filterProvenienza, 
                ...document.querySelectorAll('input[name="filterArchived"]'),
                ...document.querySelectorAll('input[name="filterFatture"]')
            ];
            inputsChange.forEach(input => input.addEventListener('change', resetAndReload));

            // Logica Modalità Selezione Utenti
            selectUsersBtn.addEventListener('click', () => {
                isSelectionMode = !isSelectionMode;
                document.querySelectorAll('.action').forEach(el => {
                    el.style.display = isSelectionMode ? 'inline-flex' : 'none';
                });
            });

            document.getElementById('actionUsersForm').addEventListener('submit', event => {
                if (!confirm("Sei sicuro di voler effettuare l'azione sugli utenti selezionati?")) {
                    event.preventDefault();
                }
            });

            // EVENT DELEGATION: Sostituisce i forEach() precedenti per le fatture
            // dato che le righe vengono caricate in modo asincrono.
            tbody.addEventListener('click', async (e) => {
                const btnElettronica = e.target.closest('.downloadFattura');
                const btnCortesia = e.target.closest('.downloadFatturaCortesia');

                if (btnElettronica) {
                    try {
                        const response = await fetch('/admin/rinnovi/downloadFattura', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ numero: btnElettronica.dataset.number })
                        });
                        handleFileDownload(response, 'Fattura Elettronica');
                    } catch (error) { alert('Errore download fattura'); }
                }

                if (btnCortesia) {
                    try {
                        const response = await fetch('/admin/downloadFatturaCortesia', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ file: btnCortesia.dataset.file })
                        });
                        handleFileDownload(response, 'Fattura Cortesia');
                    } catch (error) { alert('Errore download fattura cortesia'); }
                }
            });

            async function handleFileDownload(response, fallBackName) {
                if (!response.ok) throw new Error('Network error');
                const blob = await response.blob();
                const contentDisposition = response.headers.get('Content-Disposition');
                let fileName = fallBackName + '.pdf';
                if (contentDisposition && contentDisposition.includes('filename=')) {
                    const matches = /filename="([^"]+)"/.exec(contentDisposition);
                    if (matches && matches[1]) fileName = matches[1];
                }
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                a.remove();
            }

            loadData();
        });
    </script>
</body>
</html>